# Backend configuration.
#
# Variables consumed by backend/app/config.py use the APP_ prefix via
# pydantic-settings. Some runtime variables below are normally injected by
# start.sh, start-desktop.sh, or the Tauri desktop launcher; keep them commented
# unless you are doing manual/debug launches.

# ---------------------------------------------------------------------------
# Core backend storage / queue
# ---------------------------------------------------------------------------

# Where uploads, outputs, generation history, and settings.json are stored in
# browser-dev/manual backend runs. Desktop dev/packaged apps inject their own
# APP_DATA_DIR and should not rely on this file.
APP_DATA_DIR=data

# Redis used as Celery broker/result backend and progress pub/sub.
APP_REDIS_URL=redis://localhost:6379/0

# Filesystem queue directory used when APP_REDIS_URL=filesystem://.
# APP_CELERY_FILESYSTEM_DIR=data/celery

# Desktop launcher internal flag. Do not set manually unless debugging the
# filesystem queue fallback.
# APP_DESKTOP_FILE_STORE=0

# Job retention before automatic cleanup (hours).
APP_JOB_TTL_HOURS=24

# Per-run log directory. Development scripts create logs/runs/<timestamp> and
# inject this automatically. Packaged apps always use the app data logs dir.
# APP_RUN_LOG_DIR=../logs/runs/manual

# ---------------------------------------------------------------------------
# Upload constraints
# ---------------------------------------------------------------------------

APP_MAX_UPLOAD_MB=200

# JSON array syntax is safest for pydantic-settings complex values.
# APP_ALLOWED_EXTENSIONS=[".mp3",".wav",".flac",".m4a",".aac",".ogg"]

# ---------------------------------------------------------------------------
# Demucs / separation
# ---------------------------------------------------------------------------

# Demucs model name or model checkpoint path.
APP_DEMUCS_MODEL=htdemucs_6s

# Optional folder containing custom packaged Demucs models (*.th).
# APP_DEMUCS_MODEL_REPO=

# Override source names for a custom model. Comma-separated; empty means infer.
# APP_DEMUCS_SOURCES=lead_vocals,backing_vocals,drums,bass,other

# Optional explicit ffmpeg/ffprobe binaries. Usually not needed when using
# static-ffmpeg or packaged desktop runtime.
# APP_FFMPEG_EXE=
# APP_FFPROBE_EXE=

# ---------------------------------------------------------------------------
# ACE-Step music generation
# ---------------------------------------------------------------------------

# ACE-Step sidecar REST service address. Can point to a remote GPU host.
APP_ACESTEP_API_URL=http://127.0.0.1:8001

# Optional auth key if your ACE-Step sidecar enables authentication.
# APP_ACESTEP_API_KEY=

# Local ACE-Step source/runtime path used by browser-dev/manual runs.
APP_ACESTEP_DIR=../external/ACE-Step-1.5

# Pure CPU generation is extremely slow and disabled by default.
APP_ALLOW_CPU_GENERATION=false

# Performance mode for hardware recommendation:
# conservative | standard | quality
# APP_GENERATION_PERFORMANCE_MODE=conservative

# Disable backend-managed on-demand ACE-Step launch, for remote-only setups.
# APP_DISABLE_ACESTEP_LAUNCH=0

# Packaged desktop internals. The Tauri desktop launcher sets these when the
# bundled ACE-Step runtime is available; do not set in normal .env files.
# APP_ACESTEP_RUNTIME_DIR=
# APP_ACESTEP_LAUNCHER=

# ---------------------------------------------------------------------------
# SVC singing voice conversion
# ---------------------------------------------------------------------------

# SVC sidecar REST service address. Desktop launcher injects a dynamic local
# port; browser-dev defaults to :8002.
APP_SVC_API_URL=http://127.0.0.1:8002
