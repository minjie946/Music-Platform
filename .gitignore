# OS / editor
.DS_Store
.idea/
.vscode/
external/

# AI 生成的内部开发计划文档（含个人绝对路径，勿入库）
._agent/

# IDE / AI 工具工作目录
.trae/

# 项目内 FFmpeg/micromamba 运行时（由 start.sh 自动安装，体积大，勿入库）
vendor/

# ACE-Step 源码包（预置文件，默认放 <workspace>/resources，可在设置配置 resources_dir，勿入库）
resources/

# SVC sidecar 运行时（虚拟环境、训练样本/产物、缓存）
svc_service/.venv/
svc_service/voices/
svc_service/.work/
# SVC 大文件权重（content-vec/HuBERT/底模）：默认放项目外，首次启动按需下载，勿入库
svc_service/pretrained/
uv.lock
